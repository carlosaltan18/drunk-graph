# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123!

# FusionAuth DB
FUSIONAUTH_DB_USER=fusionauth
FUSIONAUTH_DB_PASSWORD=fusionauth

# FusionAuth app
FUSIONAUTH_PORT=9011
FUSIONAUTH_URL=http://localhost:9011
FUSIONAUTH_APP_MEMORY=512M
FUSIONAUTH_RUNTIME_MODE=development
FUSIONAUTH_ADMIN_EMAIL=admin@drunkgraph.local
FUSIONAUTH_ADMIN_PASSWORD=password123!
FUSIONAUTH_API_KEY=1e793fdd8884c168beb0ce8be7f4ddb1f6fc1e2369dd4992aa6220fb22a9f2d6
DRUNKGRAPH_TENANT_ID=04610090-b239-41c9-964e-d58bcf9fa608
DRUNKGRAPH_APPLICATION_ID=365f5abf-d4ee-451b-9ea2-26dcdfa78ba6
# FUSIONAUTH_CLIENT_ID = DRUNKGRAPH_APPLICATION_ID (FusionAuth uses the app UUID as client_id)
# openssl rand -hex 32
DRUNKGRAPH_CLIENT_SECRET=943836388fa815fe65dcec92d760e3d043b0cd9b0df34c6ad541551e2a395e59

# FusionAuth — Backoffice tenant (admin users live here, separate JWKs)
BACKOFFICE_TENANT_ID=17e7f74d-1c32-4a3b-9d11-6a2f8e4c0b5a
BACKOFFICE_APPLICATION_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
# openssl rand -hex 32
BACKOFFICE_CLIENT_SECRET=<generate_with_openssl_rand_-hex_32>
BACKOFFICE_USER_EMAIL=admin@drunkgraph.local
BACKOFFICE_USER_PASSWORD=Admin1234!
# BACKOFFICE_APPLICATION_ID is the client_id used by BetterAuth for the admin login flow
# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=<your_credential_client_id>
GOOGLE_CLIENT_SECRET=<your_secret>
GITHUB_CLIENT_ID=<your_github_client_id>
GITHUB_CLIENT_SECRET=<your_github_client_secret>

# MinIO
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=drinks
MINIO_ACCESS_KEY_ID=drunkgraph
MINIO_SECRET_ACCESS_KEY=drunkgraph123!

# Cloudinary (get from cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# Spring API
SPRING_API_URL=http://localhost:8080
# Set to "prod" in production to disable dev-only endpoints
SPRING_PROFILES_ACTIVE=dev
# FusionAuth issuer for this tenant (used by Spring to validate JWTs)
FUSIONAUTH_ISSUER_URI=http://localhost:9011
FUSIONAUTH_JWKS_URI=http://localhost:9011/.well-known/jwks.json
# Backoffice tenant JWKS — Spring uses this to validate admin JWTs independently
BACKOFFICE_ISSUER_URI=http://localhost:9011
BACKOFFICE_JWKS_URI=http://localhost:9011/api/jwt/public-key?applicationId=${BACKOFFICE_APPLICATION_ID}
