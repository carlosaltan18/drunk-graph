  "components": {
    "schemas": {
      "TasteRequest": {
        "type": "object",
        "properties": {
          "flavor": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 0
          }
        },
        "required": [
          "flavor"
        ]
      },
      "ConsumptionRequest": {
        "type": "object",
        "properties": {
          "drinkId": {
            "type": "string",
            "minLength": 1
          },
          "rating": {
            "type": "integer",
            "format": "int32",
            "maximum": 5,
            "minimum": 1
          }
        },
        "required": [
          "drinkId"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "budgetMax": {
            "type": "number",
            "format": "double"
          },
          "prefersAlcohol": {
            "type": "boolean"
          },
          "tastes": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "example": {
              "sweet": 0.8,
              "citrus": 0.5,
              "bitter": 0.2
            }
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "drinkId": {
            "type": "string"
          },
          "drink": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "scoreFlavor": {
            "type": "number",
            "format": "double"
          },
          "scorePrice": {
            "type": "number",
            "format": "double"
          },
          "scoreFinal": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Drink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "placeId": {
            "type": "string"
          },
          "alcoholPct": {
            "type": "number",
            "format": "double"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "flavors": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "example": {
              "sweet": 0.8,
              "citrus": 0.5,
              "bitter": 0.2
            }
          },
          "imageUrls": {
            "type": "array",
            "example": [
              "https://res.cloudinary.com/demo/image/upload/drinks/mojito.jpg",
              "https://res.cloudinary.com/demo/image/upload/drinks/mojito2.jpg"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Flavor": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "PlaceRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
